{
  "manifest_version": 3,
  "name": "FB Cookie Tool (Educational)",
  "version": "1.0",
  "description": "Lấy và import cookie Facebook (chỉ dùng cho tài khoản của bạn)",
  "permissions": [
    "cookies",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://facebook.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FB Cookie Tool"
  }
}